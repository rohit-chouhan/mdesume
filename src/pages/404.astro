---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/site/Header.astro";
import Footer from "@/components/site/Footer.astro";
import Icon from "@/components/site/Icon.astro";
import { href } from "@/lib/site";
---

<BaseLayout title="Page not found" noindex>
  <Header />
  <main id="main" class="flex flex-1 items-center justify-center px-6 py-24">
    <div class="max-w-md text-center">
      <p class="text-7xl font-black tracking-tight text-brand-600 dark:text-brand-400">404</p>
      <h1 class="mt-3 text-2xl font-bold text-slate-900 dark:text-white">This page took a different path</h1>
      <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
        The page you were looking for does not exist. Your resumes are safe — they live in this browser.
      </p>
      <div class="mt-6 flex flex-col justify-center gap-2 sm:flex-row">
        <a href={href("/")} class="btn btn-primary">Back home</a>
        <a href={href("/dashboard")} class="btn btn-secondary">My resumes <Icon name="arrow-right" size={16} /></a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
